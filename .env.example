# --- AI Provider (at least one required) ---
GROQ_API_KEY=your_groq_api_key
# GEMINI_API_KEY=your_gemini_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key

# --- AI Provider model selection (optional; defaults shown) ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-1.5-flash
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Resend (Email) ---
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=your_verified_sender@example.com

# --- URLs ---
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_URL=https://vidyguideai.com

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/vidyguide?schema=public

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---
JWT_SECRET=your_jwt_secret_min_16_chars
