# --- AI Provider (at least one required) ---
GROQ_API_KEY=your_groq_api_key
# GEMINI_API_KEY=your_gemini_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key

# --- AI Provider model selection (optional; defaults shown) ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-1.5-flash
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Resend (Email) ---
# Get your API key at https://resend.com/api-keys
# IMPORTANT: Verify a custom domain in Resend dashboard for production delivery.
# "onboarding@resend.dev" only delivers to the API key owner's email.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@your-verified-domain.com

# --- App URLs ---
APP_BASE_URL=https://vidyguideai-web.onrender.com
CLIENT_URL=https://vidyguideai-web.onrender.com
BACKEND_URL=https://vidyguideai-api.onrender.com
NEXT_PUBLIC_API_URL=https://vidyguideai-api.onrender.com

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/vidyguide?schema=public

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---
JWT_SECRET=your_jwt_secret_min_16_chars

# --- Environment ---
NODE_ENV=development
PORT=8000
