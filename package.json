{
  "name": "vidyguide-monorepo",
  "private": true,
  "packageManager":"pnpm@10.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter web dev & pnpm --filter api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "prisma:generate": "pnpm --filter @vidyguide/api exec prisma generate --schema=apps/api/prisma/schema.prisma",
    "prisma:deploy": "pnpm --filter @vidyguide/api exec prisma migrate deploy --schema=apps/api/prisma/schema.prisma"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
